# Set these as environment variables (PowerShell: $env:ANTHROPIC_API_KEY = "...")
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
# Actions are dry-run unless this is exactly "false"
DRY_RUN=true
# Optional: real notifications for open_ticket / notify_oncall
SLACK_WEBHOOK_URL=
# Comma-separated IPs/hosts the model may never act on (gateways, DNS, domain controllers)
PROTECTED_TARGETS=10.0.0.1,10.0.0.2
